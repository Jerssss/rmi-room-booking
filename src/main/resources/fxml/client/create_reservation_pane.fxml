<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.student.view.CreateReservationView">
    <children>
        <VBox prefHeight="74.0" prefWidth="805.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="326.0">
                            <children>
                                <Label fx:id="studResTitleLabel" text="Create Reservation" textFill="#0d3073">
                                    <font>
                                        <Font name="System Bold" size="29.0" />
                                    </font>
                                </Label>
                            </children>
                            <HBox.margin>
                                <Insets left="9.0" />
                            </HBox.margin>
                        </HBox>
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="241.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="312.0">
                           <children>
                              <TextField fx:id="searchStudResTextField" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                              <Button fx:id="searchButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#searchButtonHovered" onMouseExited="#searchButtonExited" prefHeight="26.0" prefWidth="69.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Search" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Button>
                           </children>
                           <HBox.margin>
                              <Insets right="5.0" />
                           </HBox.margin>
                        </StackPane>
                     </children>
                  </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="165.0" spacing="10.0">
                            <children>
                                <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="150.0">
                                    <children>
                              <Button fx:id="redirectCreateReservationWindowButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#createButtonHovered" onMouseExited="#createButtonExited" prefHeight="26.0" prefWidth="150.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Create Reservation" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Button>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="121.0" spacing="10.0">
                            <children>
                                <StackPane prefHeight="74.0" prefWidth="104.0">
                                    <children>
                              <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#refreshButtonHovered" onMouseExited="#refreshButtonExited" prefHeight="26.0" prefWidth="98.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Button>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
        <TableView fx:id="createReservationTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
            <columns>
                <TableColumn fx:id="terminalColumn" editable="false" prefWidth="134.0" resizable="false" text="Terminal No." />
                <TableColumn fx:id="roomNumberColumn" editable="false" prefWidth="134.0" resizable="false" text="Room No." />
                <TableColumn fx:id="terminalOSColumn" editable="false" prefWidth="134.0" resizable="false" text="Terminal OS" />
                <TableColumn fx:id="statusColumn" editable="false" prefWidth="134.0" resizable="false" text="Status" />
            <TableColumn fx:id="startTimeColumn" editable="false" prefWidth="134.0" resizable="false" text="StartTime" />
                <TableColumn fx:id="endTimeColumn" editable="false" prefWidth="134.0" resizable="false" text="EndTime" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
