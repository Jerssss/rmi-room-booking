<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.view.AddNewTerminalView">
   <children>
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="402.0">
                     <children>
                        <Label fx:id="studResTitleLabel" text="Add Terminals" textFill="#0d3073">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="9.0" />
                     </HBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="378.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="256.0">
                           <children>
                              <TextField fx:id="searchTerminalTextField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="29.0" prefWidth="230.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                              <Button fx:id="searchButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#searchButtonHovered" onMouseExited="#searchButtonExited" prefHeight="26.0" prefWidth="69.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Search" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Button>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="229.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="163.0">
                           <children>
                              <Button fx:id="redirectAddTerminalWindowButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#addTerminalButtonHovered" onMouseExited="#addTerminalButtonExited" prefHeight="26.0" prefWidth="140.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Add Terminal" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Button>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="74.0" prefWidth="175.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="61.0">
                           <children>
                              <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#refreshButtonHovered" onMouseExited="#refreshButtonExited" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Button>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="addTerminalTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="1015.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
         <columns>
            <TableColumn fx:id="terminalColumn" editable="false" prefWidth="124.0" resizable="false" text="Terminal No." />
            <TableColumn fx:id="roomNumberColumn" editable="false" prefWidth="121.0" resizable="false" text="Room No." />
            <TableColumn fx:id="terminalOSColumn" editable="false" prefWidth="126.0" resizable="false" text="Terminal OS" />
            <TableColumn fx:id="startTimeColumn" editable="false" prefWidth="114.0" resizable="false" text="Start Time" />
            <TableColumn fx:id="endTimeColumn" editable="false" prefWidth="130.0" resizable="false" text="End Time" />
            <TableColumn fx:id="statusColumn" editable="false" prefWidth="184.0" resizable="false" text="Status" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
