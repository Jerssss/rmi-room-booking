<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.admin.view.ReportGeneratorView">
   <children>
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="500.0">
                     <children>
                        <Label fx:id="reportsLabel" prefHeight="43.0" prefWidth="322.0" text="Reports" textFill="#0d3073">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                           <padding>
                              <Insets left="15.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
                  <HBox prefHeight="56.0" prefWidth="214.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="56.0" prefWidth="231.0">
                           <children>
                              <TextField fx:id="searchReportTextField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="29.0" prefWidth="230.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                              <Button fx:id="searchButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#searchButtonHovered" onMouseExited="#searchButtonExited" prefHeight="26.0" prefWidth="69.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Search" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Button>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="93.0">
                     <children>
                        <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#refreshButtonHovered" onMouseExited="#refreshButtonExited" prefHeight="26.0" prefWidth="77.0" style="-fx-background-color: #0d3073; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </HBox>
         </children>
      </VBox>

      <!-- Report Tables -->
      <VBox alignment="CENTER" prefHeight="521.0" prefWidth="805.0">
         <children>
            <TabPane fx:id="reportsTabPane" stylesheets="@../../css/tablestyles.css" tabClosingPolicy="UNAVAILABLE">
               <tabs>
                  <Tab fx:id="logReportTab" text="Log Report">
                     <content>
                        <AnchorPane>
                           <children>
                              <TableView fx:id="logReportTableView" prefHeight="482.0" prefWidth="805.0">
                                 <columns>
                                    <TableColumn fx:id="resIDColumn1" prefWidth="150.0" text="User ID" />
                                    <TableColumn fx:id="terminalColumn1" prefWidth="150.0" text="User Type" />
                                    <TableColumn fx:id="roomNumberColumn1" prefWidth="150.0" text="Actions" />
                                    <TableColumn fx:id="statusColumn1" prefWidth="150.0" text="Date" />
                                    <TableColumn fx:id="statusColumn12" prefWidth="150.0" text="Time" />
                                 </columns>
                              </TableView>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>

                  <Tab fx:id="reservationReportTab" text="Reservation Report">
                     <content>
                        <AnchorPane>
                           <children>
                              <TableView fx:id="reservationReportTableView" prefHeight="482.0" prefWidth="805.0">
                                 <columns>
                                    <TableColumn fx:id="resIDColumn11" prefWidth="150.0" text="Reservation ID" />
                                    <TableColumn fx:id="terminalColumn11" prefWidth="150.0" text="Terminal No." />
                                    <TableColumn fx:id="roomNumberColumn11" prefWidth="150.0" text="Room No." />
                                    <TableColumn fx:id="statusColumn11" prefWidth="175.0" text="Reservation Status" />
                                    <TableColumn fx:id="statusColumn111" prefWidth="175.0" text="Terminal Status" />
                                 </columns>
                              </TableView>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</VBox>
